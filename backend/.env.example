# =====================================================
# Backend Environment Configuration
# =====================================================
# Copy this file to .env and update the values

# =====================================================
# Database Configuration
# =====================================================
# Local PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=timetable
DB_PASSWORD=admin
DB_DATABASE=TimeTable

# Alternative: Use DATABASE_URL for full connection string
# Uncomment the line below for production (Railway, Heroku, etc.)
# DATABASE_URL=postgresql://username:password@host:port/database

# =====================================================
# JWT Configuration
# =====================================================
# IMPORTANT: Change these secrets in production!
JWT_SECRET=e222fdf0eed6fac3b62b1778b24532532909c27cdfbdcc151e705dd02d4501db
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-make-it-long-and-random

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =====================================================
# Server Configuration
# =====================================================
PORT=5000
NODE_ENV=development

# CORS Configuration (for frontend communication)
FRONTEND_URL=http://localhost:5173

# =====================================================
# Python Engine Configuration
# =====================================================
# Path to the Python timetable solver
PYTHON_ENGINE_PATH=./engine/solve_.py

# Python executable path (optional, uses system default if not set)
# PYTHON_PATH=/usr/bin/python3

# =====================================================
# Logging Configuration
# =====================================================
LOG_LEVEL=info

# =====================================================
# File Upload Configuration
# =====================================================
# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=10485760

# Upload directory
UPLOAD_DIR=./uploads

# =====================================================
# Email Configuration (Optional)
# =====================================================
# For sending notifications, password resets, etc.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@university.com

# =====================================================
# Session Configuration
# =====================================================
SESSION_SECRET=your-session-secret-change-this-in-production

# =====================================================
# Rate Limiting Configuration
# =====================================================
# API rate limiting (requests per minute)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=15

# =====================================================
# Cache Configuration
# =====================================================
# Redis configuration for caching (optional)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# =====================================================
# Development Configuration
# =====================================================
# Enable debug mode (shows detailed error messages)
DEBUG=true

# Enable API documentation (Swagger)
ENABLE_API_DOCS=true

# =====================================================
# Production Configuration
# =====================================================
# These settings are used in production environments

# Security headers
# ENABLE_HELMET=true
# ENABLE_RATE_LIMITING=true

# SSL/TLS settings
# FORCE_HTTPS=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Database connection pooling
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000

# =====================================================
# Monitoring and Analytics
# =====================================================
# Application monitoring (optional)
# SENTRY_DSN=your-sentry-dsn
# ANALYTICS_ID=your-analytics-id

# Health check endpoint
HEALTH_CHECK_ENDPOINT=/health
