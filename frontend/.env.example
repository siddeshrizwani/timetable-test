# =====================================================
# Frontend Environment Configuration
# =====================================================
# Copy this file to .env and update the values

# =====================================================
# API Configuration
# =====================================================
# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# =====================================================
# Application Configuration
# =====================================================
# Application name displayed in the UI
VITE_APP_NAME=University Timetable System

# Application version
VITE_APP_VERSION=1.0.0

# Environment (development, staging, production)
VITE_NODE_ENV=development

# =====================================================
# UI Configuration
# =====================================================
# Theme configuration
VITE_DEFAULT_THEME=light

# Language configuration
VITE_DEFAULT_LANGUAGE=en

# Date format
VITE_DATE_FORMAT=DD/MM/YYYY

# Time format
VITE_TIME_FORMAT=HH:mm

# =====================================================
# Feature Flags
# =====================================================
# Enable/disable features during development
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_EXPORT_FEATURES=true
VITE_ENABLE_ADVANCED_FILTERS=true

# =====================================================
# Development Configuration
# =====================================================
# Enable development tools
VITE_ENABLE_DEV_TOOLS=true

# Show debug information
VITE_DEBUG_MODE=true

# Mock data for testing
VITE_USE_MOCK_DATA=false

# =====================================================
# External Services
# =====================================================
# Google Analytics (optional)
# VITE_GA_TRACKING_ID=GA-XXXXXXXXX

# Error tracking (Sentry, etc.)
# VITE_SENTRY_DSN=your-sentry-dsn

# =====================================================
# Performance Configuration
# =====================================================
# Page size for pagination
VITE_DEFAULT_PAGE_SIZE=20

# Maximum items to show in dropdowns
VITE_MAX_DROPDOWN_ITEMS=100

# Auto-save interval in milliseconds
VITE_AUTOSAVE_INTERVAL=30000

# =====================================================
# Security Configuration
# =====================================================
# Content Security Policy (for production)
# VITE_CSP_ENABLED=false

# =====================================================
# Branding Configuration
# =====================================================
# University/Organization details
VITE_ORG_NAME=Your University
VITE_ORG_LOGO=/logo.png
VITE_ORG_WEBSITE=https://your-university.edu
VITE_ORG_CONTACT=contact@your-university.edu

# =====================================================
# Notification Configuration
# =====================================================
# Default notification duration in milliseconds
VITE_NOTIFICATION_DURATION=5000

# Toast notification position
VITE_TOAST_POSITION=top-right

# =====================================================
# File Upload Configuration
# =====================================================
# Maximum file size for uploads (in MB)
VITE_MAX_FILE_SIZE=10

# Allowed file types
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.csv

# =====================================================
# Timetable Configuration
# =====================================================
# Default view (week, day, month)
VITE_DEFAULT_TIMETABLE_VIEW=week

# Working hours
VITE_WORK_START_TIME=09:00
VITE_WORK_END_TIME=18:00

# Working days
VITE_WORKING_DAYS=1,2,3,4,5

# Time slot duration in minutes
VITE_TIME_SLOT_DURATION=60

# =====================================================
# Export Configuration
# =====================================================
# Default export format
VITE_DEFAULT_EXPORT_FORMAT=pdf

# Include logos in exports
VITE_EXPORT_INCLUDE_LOGO=true

# =====================================================
# Cache Configuration
# =====================================================
# Local storage cache duration in milliseconds
VITE_CACHE_DURATION=3600000

# Clear cache on app update
VITE_CLEAR_CACHE_ON_UPDATE=true
